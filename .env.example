MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=invest

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Email / SMTP (Gmail — for password reset + email verification)
SMTP_EMAIL=your-email@gmail.com
SMTP_APP_PASSWORD=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
PASSWORD_RESET_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440

# Frontend base URL (used in email links — password reset, email verification)
FRONTEND_BASE_URL=https://localhost:8100

# Google OAuth (same Client ID for backend verification and frontend button).
# Get one from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
